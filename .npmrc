# Make the `engines` field in package.json a gate, not a suggestion.
#
# npm treats `engines` as advisory by default: on an unsupported Node it prints a
# warning nobody reads and installs anyway. The break then surfaces much later as a
# missing `styleText` export from node:util, which names neither Node nor a version
# and reads as "this project is broken".
#
# With engine-strict, `npm ci` refuses immediately and says which version is needed.
# This protects the person who does NOT already know there is a version constraint —
# .nvmrc only helps someone who already knows to run `nvm use`.
engine-strict=true
